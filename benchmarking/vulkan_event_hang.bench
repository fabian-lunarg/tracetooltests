{
	"name": "vulkan_event_hang",
	"description": "Arm a capture where an unsynchronized host vkGetEventStatus races a device set/reset pair; an unbounded wait-for-VK_EVENT_SET replayer can hang when replayed in a loop",
	"capabilities": {
		"non_interactive": {
			"default": true,
			"modifiable": false
		},
		"frameless": {
			"default": true,
			"modifiable": false
		},
		"fixed_framerate": {
			"default": true,
			"modifiable": false
		}
	}
}
